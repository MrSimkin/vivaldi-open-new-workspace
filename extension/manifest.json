{
  "manifest_version": 3,
  "name": "Open New Workspace",
  "version": "0.1.5",
  "description": "Personal Vivaldi workspace integration (experimental).",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open New Workspace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nw-16.png",
      "32": "icons/nw-32.png",
      "48": "icons/nw-48.png"
    }
  },
  "icons": {
    "16": "icons/nw-16.png",
    "32": "icons/nw-32.png",
    "48": "icons/nw-48.png",
    "128": "icons/nw-128.png"
  }
}
